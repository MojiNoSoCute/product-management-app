# ==============================================================================
# Backend Environment Variables (.env)
# ==============================================================================

# พอร์ตสำหรับเซิร์ฟเวอร์ Backend (ค่าเริ่มต้น 5000)
BACKEND_PORT=5000

# โหมดการทำงาน (development หรือ production)
NODE_ENV=development

# การเชื่อมต่อฐานข้อมูล PostgreSQL
DB_HOST=postgres-db   # หรือ localhost เมื่อรันนอก Docker
DB_PORT=5432         # พอร์ต PostgreSQL
DB_NAME=product_db   # ชื่อฐานข้อมูล
DB_USER=dev_user     # ชื่อผู้ใช้งาน
DB_PASSWORD=dev_password # รหัสผ่านฐานข้อมูล