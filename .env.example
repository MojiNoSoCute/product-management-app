# ==============================================================================
# Root Environment Variables (.env)
# ใช้สำหรับกำหนดค่าการทำงานของ Docker Compose และบริการต่างๆ
# ==============================================================================

# พอร์ตสำหรับเซิร์ฟเวอร์ Backend บนเครื่องโฮสต์ (Host Port)
BACKEND_PORT=5000

# พอร์ตสำหรับเว็บแอปพลิเคชัน Frontend บนเครื่องโฮสต์ (Host Port)
FRONTEND_PORT=5173

# --- การตั้งค่า PostgreSQL Database Container ---
POSTGRES_USER=dev_user          # ชื่อผู้ใช้ฐานข้อมูลเริ่มต้น
POSTGRES_PASSWORD=dev_password  # รหัสผ่านผู้ใช้ฐานข้อมูล
POSTGRES_DB=product_db          # ชื่อฐานข้อมูลเริ่มต้น
POSTGRES_PORT=5432              # พอร์ต PostgreSQL บนเครื่องโฮสต์

# --- การตั้งค่าการเชื่อมต่อฐานข้อมูลสำหรับ Backend ---
NODE_ENV=development           # โหมดการทำงาน (development หรือ production)
DB_HOST=postgres-db             # โฮสต์ของฐานข้อมูล (ใน Docker Compose ใช้ชื่อ service: postgres-db, ถ้ารันในเครื่องให้ใช้ localhost)
DB_PORT=5432                   # พอร์ตฐานข้อมูลภายในเครือข่าย Docker
DB_NAME=product_db             # ชื่อฐานข้อมูลที่ต้องการเชื่อมต่อ
DB_USER=dev_user               # ชื่อผู้ใช้งานสำหรับเชื่อมต่อ
DB_PASSWORD=dev_password       # รหัสผ่านสำหรับเชื่อมต่อ

# --- การตั้งค่าสำหรับ Frontend ---
VITE_API_URL=http://localhost:5000 # Base URL ของ API ฝั่ง Backend ที่ Frontend จะเรียกใช้งาน